#!/usr/bin/env bash
# verify-hugo — launch, doctor, and teardown for Hugo dev-server verification runs.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
RUN_ID="${VERIFY_RUN_ID:-verify-$$}"
PORT="${VERIFY_HUGO_PORT:-1314}"
BIND="${VERIFY_HUGO_BIND:-127.0.0.1}"
BASE_URL="http://${BIND}:${PORT}"
STATE_DIR="${VERIFY_STATE_DIR:-/tmp/verify-hugo-${RUN_ID}}"
PID_FILE="${STATE_DIR}/hugo.pid"
LOG_FILE="${STATE_DIR}/hugo.log"
ARTIFACTS_DIR="${VERIFY_ARTIFACTS_DIR:-${ROOT}/.verify/artifacts/${RUN_ID}}"
ARTIFACTS_ROOT="${ROOT}/.verify/artifacts"

usage() {
  cat <<EOF
Usage: verify-hugo <command>

Commands:
  launch    Start hugo server for verification (background, dedicated port)
  doctor    Read-only health check for the verification instance
  url       Print the base URL
  artifacts Print the artifacts directory for this run
  stop      Stop the verification hugo server started by launch

Environment:
  VERIFY_RUN_ID       Unique run id (default: verify-\$\$)
  VERIFY_HUGO_PORT    Port (default: 1314; avoids dev default 1313)
  VERIFY_HUGO_BIND    Bind address (default: 127.0.0.1)
  VERIFY_STATE_DIR    State dir (default: /tmp/verify-hugo-\$RUN_ID)
  VERIFY_ARTIFACTS_DIR Proof output dir (default: .verify/artifacts/\$RUN_ID; previous default-tree runs are deleted on launch)

Hugo server flags follow https://gohugo.io/commands/hugo_server/
EOF
}

require_hugo() {
  if ! command -v hugo >/dev/null 2>&1; then
    echo "error: hugo not found. Install Hugo Extended — see https://gohugo.io/installation/" >&2
    exit 1
  fi
  local ver
  ver="$(hugo version 2>&1)"
  if [[ "${ver}" != *extended* ]]; then
    echo "error: hugo extended required (SCSS pipeline). Got: ${ver}" >&2
    exit 1
  fi
  echo "${ver}"
}

port_owner_pid() {
  lsof -tiTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null | head -1 || true
}

cleanup_previous_artifacts() {
  # Skip when caller pins a custom artifacts path outside the default tree.
  if [[ -n "${VERIFY_ARTIFACTS_DIR:-}" ]]; then
    return 0
  fi
  if [[ ! -d "${ARTIFACTS_ROOT}" ]]; then
    return 0
  fi
  local dir name
  for dir in "${ARTIFACTS_ROOT}"/*; do
    [[ -d "${dir}" ]] || continue
    name="$(basename "${dir}")"
    [[ "${name}" == "${RUN_ID}" ]] && continue
    rm -rf "${dir}"
    echo "cleaned previous artifacts: ${dir}"
  done
}

launch() {
  require_hugo >/dev/null
  cleanup_previous_artifacts
  mkdir -p "${STATE_DIR}" "${ARTIFACTS_DIR}"

  if [[ -f "${PID_FILE}" ]]; then
    local old_pid
    old_pid="$(cat "${PID_FILE}")"
    if kill -0 "${old_pid}" 2>/dev/null; then
      echo "error: verification server already running (pid ${old_pid}). Run: verify-hugo stop" >&2
      exit 1
    fi
  fi

  local foreign_pid
  foreign_pid="$(port_owner_pid)"
  if [[ -n "${foreign_pid}" ]]; then
    echo "error: port ${PORT} already in use by pid ${foreign_pid}. Set VERIFY_HUGO_PORT." >&2
    exit 1
  fi

  cd "${ROOT}"
  # -D includes drafts; --disableLiveReload keeps screenshots stable.
  # See https://gohugo.io/getting-started/usage/#develop-and-test-your-site
  nohup hugo server \
    -D \
    --port "${PORT}" \
    --bind "${BIND}" \
    --disableLiveReload \
    >"${LOG_FILE}" 2>&1 &
  echo $! >"${PID_FILE}"

  for _ in $(seq 1 30); do
    if curl -sf "${BASE_URL}/" >/dev/null 2>&1; then
      echo "ready ${BASE_URL}"
      echo "pid $(cat "${PID_FILE}")"
      echo "log ${LOG_FILE}"
      echo "artifacts ${ARTIFACTS_DIR}"
      return 0
    fi
    sleep 0.2
  done

  echo "error: hugo did not become ready. Log:" >&2
  tail -20 "${LOG_FILE}" >&2 || true
  stop || true
  exit 1
}

doctor() {
  local hugo_ver
  hugo_ver="$(require_hugo)"
  echo "hugo: ${hugo_ver}"

  if [[ ! -f "${PID_FILE}" ]]; then
    echo "status: no verification pid file at ${PID_FILE}"
    exit 1
  fi

  local pid
  pid="$(cat "${PID_FILE}")"
  if ! kill -0 "${pid}" 2>/dev/null; then
    echo "status: stale pid ${pid}"
    exit 1
  fi

  local owner
  owner="$(port_owner_pid)"
  if [[ "${owner}" != "${pid}" ]]; then
    echo "status: pid ${pid} alive but port ${PORT} owned by ${owner:-none}"
    exit 1
  fi

  local code home_title
  code="$(curl -s -o /dev/null -w '%{http_code}' "${BASE_URL}/")"
  home_title="$(curl -s "${BASE_URL}/" | sed -n 's/.*<title[^>]*>\([^<]*\)<\/title>.*/\1/p' | head -1)"

  echo "url: ${BASE_URL}"
  echo "pid: ${pid}"
  echo "home_http: ${code}"
  echo "home_title: ${home_title}"
  echo "artifacts: ${ARTIFACTS_DIR}"

  [[ "${code}" == "200" ]] || exit 1
  [[ -n "${home_title}" ]] || exit 1
}

stop() {
  if [[ ! -f "${PID_FILE}" ]]; then
    echo "no verification server to stop"
    return 0
  fi
  local pid
  pid="$(cat "${PID_FILE}")"
  if kill -0 "${pid}" 2>/dev/null; then
    kill "${pid}" 2>/dev/null || true
    for _ in $(seq 1 20); do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "${pid}" 2>/dev/null; then
      kill -9 "${pid}" 2>/dev/null || true
    fi
  fi
  rm -f "${PID_FILE}"
  echo "stopped pid ${pid}"
}

cmd="${1:-}"
case "${cmd}" in
  launch) launch ;;
  doctor) doctor ;;
  url) echo "${BASE_URL}" ;;
  artifacts) echo "${ARTIFACTS_DIR}" ;;
  stop) stop ;;
  *) usage; exit 1 ;;
esac
