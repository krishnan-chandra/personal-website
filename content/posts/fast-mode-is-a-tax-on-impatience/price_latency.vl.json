{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Per-token cost vs. standard tier",
  "width": "container",
  "height": 280,
  "data": {
    "values": [
      {
        "tier": "Batch / Flex (50% off)",
        "label": "Batch / Flex",
        "price": 0.5,
        "kind": "Discount"
      },
      {
        "tier": "Standard",
        "label": "Standard",
        "price": 1.0,
        "kind": "Standard"
      },
      {
        "tier": "Opus / Sol Fast (API)",
        "label": "Opus / Sol Fast",
        "price": 2.0,
        "kind": "Fast"
      },
      {
        "tier": "Codex subscription Fast",
        "label": "Codex Fast (credits)",
        "price": 2.5,
        "kind": "Fast"
      },
      {
        "tier": "Composer 2.5 Fast",
        "label": "Composer 2.5 Fast",
        "price": 6.0,
        "kind": "Fast"
      }
    ]
  },
  "layer": [
    {
      "mark": { "type": "rule", "strokeDash": [5, 4], "color": "#999999" },
      "encoding": {
        "x": { "datum": 1 }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2,
        "height": 22
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": { "field": "price", "order": "ascending" },
          "scale": { "paddingInner": 0.35, "paddingOuter": 0.2 },
          "axis": { "labelFontSize": 12, "ticks": false, "domain": false }
        },
        "x": {
          "field": "price",
          "type": "quantitative",
          "title": "Cost multiplier vs. standard",
          "scale": { "domain": [0, 6.5] }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "title": "Tier type",
          "scale": {
            "domain": ["Discount", "Standard", "Fast"],
            "range": ["#3f8f4f", "#333333", "#d64545"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Tier type",
            "offset": 8
          }
        },
        "tooltip": [
          { "field": "tier", "title": "Tier" },
          { "field": "price", "title": "Cost multiplier" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": 500
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": { "field": "price", "order": "ascending" }
        },
        "x": { "field": "price", "type": "quantitative" },
        "text": { "field": "price", "type": "quantitative", "format": ".1f" },
        "color": {
          "field": "kind",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true, "gridOpacity": 0.35 },
    "title": { "fontSize": 14, "offset": 10 }
  }
}
