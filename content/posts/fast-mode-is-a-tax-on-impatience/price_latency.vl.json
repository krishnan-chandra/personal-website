{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "What a dollar of 'speed' actually buys",
  "width": "container",
  "height": 420,
  "encoding": {
    "x": {
      "field": "price",
      "type": "quantitative",
      "title": "Price multiplier vs. standard",
      "scale": { "domain": [0, 6.5], "nice": false, "padding": 12 }
    },
    "y": {
      "field": "speed",
      "type": "quantitative",
      "title": "Speed multiplier vs. standard",
      "scale": { "domain": [0, 3], "nice": false, "padding": 12 }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          { "price": 0, "speed": 0 },
          { "price": 3, "speed": 3 }
        ]
      },
      "mark": { "type": "line", "strokeDash": [6, 4], "color": "#999999" }
    },
    {
      "data": {
        "values": [
          {
            "tier": "Batch / Flex (50% off)",
            "label": "Batch / Flex",
            "price": 0.5,
            "speed": 0.35,
            "kind": "Discount",
            "align": "center",
            "baseline": "top",
            "dx": 0,
            "dy": 14
          },
          {
            "tier": "Standard",
            "label": "Standard",
            "price": 1.0,
            "speed": 1.0,
            "kind": "Standard",
            "align": "center",
            "baseline": "top",
            "dx": 0,
            "dy": 14
          },
          {
            "tier": "Opus / Sol Fast (advertised, output only)",
            "label": "Opus / Sol Fast",
            "price": 2.0,
            "speed": 2.5,
            "kind": "Fast",
            "align": "left",
            "baseline": "middle",
            "dx": 14,
            "dy": 0
          },
          {
            "tier": "Codex subscription Fast",
            "label": "Codex Fast (credits)",
            "price": 2.5,
            "speed": 1.5,
            "kind": "Fast",
            "align": "left",
            "baseline": "middle",
            "dx": 14,
            "dy": 0
          },
          {
            "tier": "Composer 2.5 Fast (at 2.5x claim)",
            "label": "Composer 2.5 Fast",
            "price": 6.0,
            "speed": 2.5,
            "kind": "Fast",
            "align": "right",
            "baseline": "middle",
            "dx": -14,
            "dy": 0
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 110,
            "opacity": 1
          },
          "encoding": {
            "color": {
              "field": "kind",
              "type": "nominal",
              "title": "Tier type",
              "scale": {
                "domain": ["Discount", "Standard", "Fast"],
                "range": ["#3f8f4f", "#333333", "#d64545"]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "title": "Tier type",
                "offset": 12
              }
            },
            "tooltip": [
              { "field": "tier", "title": "Tier" },
              { "field": "price", "title": "Price multiplier" },
              { "field": "speed", "title": "Speed multiplier" }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 500,
            "dx": { "expr": "datum.dx" },
            "dy": { "expr": "datum.dy" },
            "align": { "expr": "datum.align" },
            "baseline": { "expr": "datum.baseline" }
          },
          "encoding": {
            "text": { "field": "label" },
            "color": {
              "field": "kind",
              "type": "nominal",
              "legend": null
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true, "gridOpacity": 0.35 },
    "title": { "fontSize": 14, "offset": 12 }
  }
}
